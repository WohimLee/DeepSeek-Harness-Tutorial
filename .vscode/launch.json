{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Harness: 当前阶段",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests",
        "-vv",
        "-s",
        "--maxfail=1"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONASYNCIODEBUG": "1",
        "DSH_CORDIS_LOG": "1",
        "DSH_CORDIS_LOG_LEVEL": "DEBUG"
      }
    },
